import sys, io
import boto3
import pandas as pd
import numpy as np


s3 = boto3.client("s3")


def get_arg(name, default=None):
    k = f"--{name}"
    return sys.argv[sys.argv.index(k)+1] if k in sys.argv else default

def parse_s3(path):
    path = path.replace("s3://", "", 1)
    bucket, key = path.split("/", 1)
    return bucket, key

def s3_read_csv(path):
    b, k = parse_s3(path)
    obj = s3.get_object(Bucket=b, Key=k)
    return pd.read_csv(io.BytesIO(obj["Body"].read()), encoding="utf-8-sig")

def s3_write_csv(df, path):
    b, k = parse_s3(path)
    buf = io.StringIO()
    df.to_csv(buf, index=False)
    s3.put_object(
        Bucket=b,
        Key=k,
        Body=buf.getvalue().encode("utf-8"),
        ContentType="text/csv"
    )

def must_have(df, cols, name):
    missing = [c for c in cols if c not in df.columns]
    if missing:
        print(f"[ERROR] Missing columns in {name}: {missing}")
        print(f"[DEBUG] Available columns sample:", list(df.columns)[:120])
        raise KeyError(str(missing))


SILVER = get_arg("SILVER_BASE", "s3://yahoo-finance-silver/silver/").rstrip("/") + "/"
GOLD   = get_arg("GOLD_BASE",   "s3://yahoo-finance-gold/tables/").rstrip("/") + "/"

IN_PATH  = SILVER + "merged_etfs.csv"
OUT_PATH = GOLD + "dim_fund_bonds/dim_fund_bonds.csv"


m = s3_read_csv(IN_PATH)
print("Loaded rows:", len(m))

required_src = [
    "fund_bonds_aaa",
    "fund_bonds_aa",
    "fund_bonds_a",
    "fund_bonds_bbb",
    "fund_bonds_bb",
    "fund_bonds_b",
    "fund_bonds_below_b",
    "fund_bonds_us_government",
    "fund_bonds_others",
    "fund_bond_duration"
]
must_have(m, required_src, "merged_etfs.csv")


df = pd.DataFrame({
    "bonds_aaa": m["fund_bonds_aaa"],
    "bonds_aa": m["fund_bonds_aa"],
    "bonds_a": m["fund_bonds_a"],
    "bonds_bbb": m["fund_bonds_bbb"],
    "bonds_bb": m["fund_bonds_bb"],
    "bonds_b": m["fund_bonds_b"],
    "bonds_below_b": m["fund_bonds_below_b"],
    "bonds_us_government": m["fund_bonds_us_government"],
    "bonds_others": m["fund_bonds_others"],
    "bond_duration": m["fund_bond_duration"],
})

for c in df.columns:
    df[c] = pd.to_numeric(df[c], errors="coerce")

df = df.dropna(how="all", subset=list(df.columns))

print("Rows after dropna(all bond cols):", len(df))

df = df.drop_duplicates().reset_index(drop=True)

df.insert(0, "bonds_id", range(1, len(df) + 1))


s3_write_csv(df, OUT_PATH)
print("Saved:", OUT_PATH)
print("Rows:", len(df))
print(df.head(10))
