import sys, io
import boto3
import pandas as pd


def get_arg(name, default=None):
    k = f"--{name}"
    return sys.argv[sys.argv.index(k) + 1] if k in sys.argv else default

def parse_s3(path):
    path = path.replace("s3://", "", 1)
    bucket, key = path.split("/", 1)
    return bucket, key

def s3_read_csv_strict(path):
    """
    Read CSV with:
    - sep=',' (your file is true CSV)
    - encoding='utf-8-sig' (removes BOM if exists)
    """
    b, k = parse_s3(path)
    obj = s3.get_object(Bucket=b, Key=k)
    data = obj["Body"].read()
    return pd.read_csv(io.BytesIO(data), sep=",", encoding="utf-8-sig")

def s3_write_csv(df, path):
    b, k = parse_s3(path)
    buf = io.StringIO()
    df.to_csv(buf, index=False)
    s3.put_object(
        Bucket=b,
        Key=k,
        Body=buf.getvalue().encode("utf-8"),
        ContentType="text/csv"
    )

def clean_cols(df):
    df.columns = [c.replace("\ufeff", "").strip() for c in df.columns]
    return df

def must_have(df, cols, name):
    missing = [c for c in cols if c not in df.columns]
    if missing:
        print(f"[ERROR] Missing columns in {name}: {missing}")
        print(f"[DEBUG] Columns in {name}: {list(df.columns)}")
        raise KeyError(str(missing))


s3 = boto3.client("s3")

SILVER = get_arg("SILVER_BASE", "s3://yahoo-finance-silver/silver/").rstrip("/") + "/"
GOLD   = get_arg("GOLD_BASE",   "s3://yahoo-finance-gold/tables/").rstrip("/") + "/"

TOP10_PATH    = SILVER + "top10_holdings.csv"
DIM_FUND_PATH = GOLD   + "dim_fund/dim_fund.csv"
OUT_PATH      = GOLD   + "dim_top_holdings/dim_top_holdings.csv"


top10 = clean_cols(s3_read_csv_strict(TOP10_PATH))
dim_fund = clean_cols(s3_read_csv_strict(DIM_FUND_PATH))

print("Top10 columns:", list(top10.columns))
print("Dim_fund columns:", list(dim_fund.columns))

must_have(top10, ["fund_id", "holding_rank", "holding_ticker", "holding_name", "holding_weight"], "top10_holdings.csv")
must_have(dim_fund, ["fund_id", "fund_symbol"], "dim_fund.csv")

top10["fund_symbol"] = top10["fund_id"].fillna("").astype(str).str.strip()
dim_fund["fund_symbol"] = dim_fund["fund_symbol"].fillna("").astype(str).str.strip()

joined = top10.merge(
    dim_fund[["fund_id", "fund_symbol"]].rename(columns={"fund_id": "fund_id_int"}),
    on="fund_symbol",
    how="left"
)

unmatched = joined[joined["fund_id_int"].isna()][["fund_symbol"]].drop_duplicates()
print("Unmatched fund symbols count:", len(unmatched))
if len(unmatched) > 0:
    print("Sample unmatched:", unmatched.head(20).to_dict(orient="records"))


out_df = pd.DataFrame({
    "fund_id": pd.to_numeric(joined["fund_id_int"], errors="coerce"),
    "fund_symbol": joined["fund_symbol"],

    "holding_rank": pd.to_numeric(joined["holding_rank"], errors="coerce"),
    "holding_ticker": joined["holding_ticker"].fillna("").astype(str).str.strip(),
    "holding_name": joined["holding_name"].fillna("").astype(str).str.strip(),
    "holding_weight_pct": pd.to_numeric(joined["holding_weight"], errors="coerce"),
})

before = len(out_df)
out_df = out_df.dropna(subset=["fund_id", "holding_rank"])
after = len(out_df)
print("Rows before filter:", before, "after filter:", after)

out_df["fund_id"] = out_df["fund_id"].astype(int)
out_df["holding_rank"] = out_df["holding_rank"].astype(int)

out_df = out_df.sort_values(["fund_id", "holding_rank", "holding_ticker"]).reset_index(drop=True)
out_df.insert(0, "top_holdings_id", range(1, len(out_df) + 1))


out_df = out_df[
    [
        "top_holdings_id",
        "fund_id",
        "fund_symbol",
        "holding_rank",
        "holding_ticker",
        "holding_name",
        "holding_weight_pct",
    ]
]


s3_write_csv(out_df, OUT_PATH)
print("Saved:", OUT_PATH)
print("Rows:", len(out_df))
print(out_df.head(10))
