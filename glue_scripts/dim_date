import sys
import io
import boto3
import pandas as pd


def get_arg(name, default=None):
    key = f"--{name}"
    if key in sys.argv:
        i = sys.argv.index(key)
        if i + 1 < len(sys.argv):
            return sys.argv[i + 1]
    return default


SILVER_ETF2000_PATH = get_arg("SILVER_ETF2000_PATH", "s3://yahoo-finance-silver/silver/etf from 2000.csv")
GOLD_DIM_DATE_PATH  = get_arg("GOLD_DIM_DATE_PATH",  "s3://yahoo-finance-gold/tables/dim_date/dim_date.csv")


def parse_s3_path(s3_path: str):
    if not s3_path.startswith("s3://"):
        raise ValueError("S3 path must start with s3://")
    no_scheme = s3_path.replace("s3://", "", 1)
    parts = no_scheme.split("/", 1)
    bucket = parts[0]
    key = parts[1] if len(parts) > 1 else ""
    return bucket, key

s3 = boto3.client("s3")


in_bucket, in_key = parse_s3_path(SILVER_ETF2000_PATH)
obj = s3.get_object(Bucket=in_bucket, Key=in_key)
df = pd.read_csv(io.BytesIO(obj["Body"].read()))

if "price_date" not in df.columns:
    raise ValueError(f"Column 'price_date' not found. Columns are: {list(df.columns)}")

# Build dim_date

dates = pd.to_datetime(df["price_date"], errors="coerce").dropna().dt.date
dates = pd.Series(dates).drop_duplicates().sort_values()

dim_date = pd.DataFrame({"price_date": dates})
dim_date["date_id"] = pd.to_datetime(dim_date["price_date"]).dt.strftime("%Y%m%d").astype(int)
dim_date["year"] = pd.to_datetime(dim_date["price_date"]).dt.year.astype(int)
dim_date["quarter"] = pd.to_datetime(dim_date["price_date"]).dt.quarter.astype(int)
dim_date["month"] = pd.to_datetime(dim_date["price_date"]).dt.month.astype(int)
dim_date["day"] = pd.to_datetime(dim_date["price_date"]).dt.day.astype(int)

dim_date = dim_date[["date_id", "price_date", "year", "quarter", "month", "day"]]

print("dim_date rows:", len(dim_date))
print(dim_date.head(10))


out_bucket, out_key = parse_s3_path(GOLD_DIM_DATE_PATH)

csv_buffer = io.StringIO()
dim_date.to_csv(csv_buffer, index=False)

s3.put_object(
    Bucket=out_bucket,
    Key=out_key,
    Body=csv_buffer.getvalue().encode("utf-8"),
    ContentType="text/csv"
)

print(f"Saved dim_date to: s3://{out_bucket}/{out_key}")
