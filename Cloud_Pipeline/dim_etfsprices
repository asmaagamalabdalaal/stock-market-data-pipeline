import sys, io, boto3, pandas as pd, numpy as np

def get_arg(n,d=None):
    k=f"--{n}"; return sys.argv[sys.argv.index(k)+1] if k in sys.argv else d

def parse_s3(p):
    p=p.replace("s3://","",1); b,k=p.split("/",1); return b,k

def s3_read_csv(p):
    b,k=parse_s3(p); obj=s3.get_object(Bucket=b,Key=k)
    return pd.read_csv(io.BytesIO(obj["Body"].read()))

def s3_write_csv(df,p):
    b,k=parse_s3(p); buf=io.StringIO(); df.to_csv(buf,index=False)
    s3.put_object(Bucket=b,Key=k,Body=buf.getvalue().encode("utf-8"),ContentType="text/csv")

def col(df,name): return df[name] if name in df.columns else np.nan

s3=boto3.client("s3")
SILVER=get_arg("SILVER_BASE","s3://yahoo-finance-silver/silver/").rstrip("/")+"/"
GOLD=get_arg("GOLD_BASE","s3://yahoo-finance-gold/tables/").rstrip("/")+"/"

etf = s3_read_csv(SILVER + "etf from 2000.csv")
dt = pd.to_datetime(etf["price_date"], errors="coerce")
date_id = dt.dt.strftime("%Y%m%d")

out_df = pd.DataFrame({
    "date_id": pd.to_numeric(date_id, errors="coerce").astype("Int64"),
    "high": pd.to_numeric(col(etf,"high"), errors="coerce"),
    "open": pd.to_numeric(col(etf,"open"), errors="coerce"),
    "low": pd.to_numeric(col(etf,"low"), errors="coerce"),
    "adj_close": pd.to_numeric(col(etf,"adj_close"), errors="coerce"),
    "volume": pd.to_numeric(col(etf,"volume"), errors="coerce").astype("Int64"),
})

out_df = out_df.dropna(subset=["date_id"]).drop_duplicates()
out_df = out_df.sort_values(["date_id"]).reset_index(drop=True)
out_df.insert(0, "price_id", range(1, len(out_df)+1))

out = GOLD + "dim_etfs_prices/dim_etfs_prices.csv"
s3_write_csv(out_df, out)
print("Saved:", out)
