import boto3
import io
import pandas as pd
import numpy as np
import json
import re

# ============================
# S3 settings
# ============================
BRONZE_BUCKET = "yahoo-finance-bronze"
BRONZE_PREFIX = "half/"

SILVER_BUCKET = "yahoo-finance-silver"
SILVER_PREFIX = "silver/"

# Inputs (raw) in bronze
MERGED_ETF_KEY_BRONZE = BRONZE_PREFIX + "merged_etfs.csv"
ETF2000_KEY_BRONZE = BRONZE_PREFIX + "etf from 2000.csv"

# Final outputs in silver
MUTUAL_OUTPUT_KEY_SILVER = SILVER_PREFIX + "MutualFund_prices_2000_A_Z.csv"
MERGED_ETF_KEY_SILVER = SILVER_PREFIX + "merged_etfs.csv"
INVESTMENT_STRATEGY_KEY_SILVER = SILVER_PREFIX + "investment_strategy.csv"
TOP10_HOLDINGS_KEY_SILVER = SILVER_PREFIX + "top10_holdings.csv"
ETF2000_KEY_SILVER = SILVER_PREFIX + "etf from 2000.csv"

s3 = boto3.client("s3")


def read_csv_from_s3(bucket, key):
    """Read CSV from S3 into a DataFrame."""
    obj = s3.get_object(Bucket=bucket, Key=key)
    return pd.read_csv(io.BytesIO(obj["Body"].read()))


def write_csv_to_s3(df, bucket, key):
    """Write a DataFrame as CSV to S3."""
    csv_buffer = io.StringIO()
    df.to_csv(csv_buffer, index=False)
    s3.put_object(Bucket=bucket, Key=key, Body=csv_buffer.getvalue())
    print(f"Saved to s3://{bucket}/{key}")


def list_mutual_fund_files():
    """
    List the four mutual fund half files inside the 'half/' prefix.
    Expected names (or similar):
      half/MutualFund prices 2000- A-E half.csv
      half/MutualFund prices 2000- f-k half.csv
      half/MutualFund prices 2000- l-p half.csv
      half/MutualFund prices 2000- q-z half.csv
    """
    keys = []
    paginator = s3.get_paginator("list_objects_v2")
    for page in paginator.paginate(Bucket=BRONZE_BUCKET, Prefix=BRONZE_PREFIX):
        for obj in page.get("Contents", []):
            key = obj["Key"]
            print("FOUND OBJECT:", key)
            if (
                key.startswith(BRONZE_PREFIX + "MutualFund prices 2000-")
                and key.endswith("half.csv")
            ):
                keys.append(key)

    print("FILTERED MutualFund files:", keys)
    return keys


def parse_top10_string(top10_str):
    """Parse one 'top10_holdings' string into a list of holdings dicts."""
    if pd.isna(top10_str) or str(top10_str).strip() == "":
        return []

    text = str(top10_str)
    parts = [p.strip() for p in text.split(",") if p.strip()]

    item_pattern = re.compile(r"(.+?):\s*([0-9.]+)")
    name_pat = re.compile(r'([A-Za-z0-9.\-\s]+?)\s*\("(.+)"\)')
    name_pat2 = re.compile(r'([A-Za-z0-9.\-\s]+?)\s*\((.+)\)')

    holdings = []

    for rank, part in enumerate(parts, start=1):
        m = item_pattern.match(part)
        if not m:
            continue

        label = m.group(1).strip()
        weight_str = m.group(2).strip()

        weight_str = weight_str.replace("%", "")
        try:
            weight = float(weight_str)
        except ValueError:
            weight = pd.NA

        label_clean = label.strip()

        if label_clean.startswith('"') and label_clean.endswith('"'):
            holding_ticker = None
            holding_name = label_clean.strip('"')
        else:
            m2 = name_pat.match(label_clean)
            if m2:
                holding_ticker = m2.group(1).strip()
                holding_name = m2.group(2).strip()
            else:
                m3 = name_pat2.match(label_clean)
                if m3:
                    holding_ticker = m3.group(1).strip()
                    holding_name = m3.group(2).strip(' "')
                else:
                    holding_ticker = None
                    holding_name = label_clean.strip('"')

        holdings.append({
            "holding_rank": rank,
            "holding_ticker": holding_ticker,
            "holding_name": holding_name,
            "holding_weight": weight,
        })

    return holdings


def extract_objective_type(text: str) -> str:
    if not isinstance(text, str):
        return "Unknown"
    t = text.lower()
    parts = []
    if "total return" in t:
        parts.append("Total return")
    if "capital growth" in t or "capital appreciation" in t or "growth" in t:
        parts.append("Capital growth")
    if "current income" in t or "income" in t:
        parts.append("Income")
    if not parts:
        return "Unknown"
    return " + ".join(sorted(set(parts)))


def extract_primary_asset_theme(text: str) -> str:
    if not isinstance(text, str):
        return "Unknown"
    t = text.lower()
    if "real assets" in t:
        return "Real assets"
    if "equity" in t:
        return "Equity"
    if "fixed income" in t or "bonds" in t:
        return "Fixed income / Bonds"
    if "commodities" in t:
        return "Commodities"
    return "Unknown"


def extract_geo_focus(text: str) -> str:
    if not isinstance(text, str):
        return "Unknown"
    t = text.lower()
    if (
        "global" in t
        or "worldwide" in t
        or "foreign issuers" in t
        or "international" in t
    ):
        if "emerging markets" in t or "new or emerging markets" in t:
            return "Global & Emerging markets"
        return "Global / International"
    if "emerging markets" in t:
        return "Emerging markets"
    if "u.s." in t or "united states" in t:
        return "US"
    if "europe" in t:
        return "Europe"
    return "Unknown"


def main():
    # =====================================
    # 1) MutualFund: merge half files, swap open/close, save to silver
    # =====================================
    files = list_mutual_fund_files()
    print("Files detected:", files)

    if not files:
        raise ValueError(
            "No MutualFund prices 2000- * half.csv files found under "
            f"s3://{BRONZE_BUCKET}/{BRONZE_PREFIX}. Please check file names and location."
        )

    dfs = []
    for key in files:
        df_part = read_csv_from_s3(BRONZE_BUCKET, key)
        dfs.append(df_part)
        print(f"Loaded: {key} | Shape: {df_part.shape}")

    df_all = pd.concat(dfs, ignore_index=True)
    print("\nCombined Shape:", df_all.shape)

    df_all["price_date"] = pd.to_datetime(df_all["price_date"], errors="coerce")
    df_all = df_all.sort_values(
        by=["fund_symbol", "price_date"],
        ascending=[True, True]
    ).reset_index(drop=True)

    # Create open from nav_per_share then close as shifted open
    df_mutual = df_all.copy()
    if "Unnamed: 0" in df_mutual.columns:
        df_mutual = df_mutual.drop(columns=["Unnamed: 0"])

    df_mutual = df_mutual.rename(columns={"nav_per_share": "open"})
    df_mutual["close"] = df_mutual["open"].shift(1)

    # Swap open and close values
    tmp = df_mutual["open"].copy()
    df_mutual["open"] = df_mutual["close"]
    df_mutual["close"] = tmp

    write_csv_to_s3(df_mutual, SILVER_BUCKET, MUTUAL_OUTPUT_KEY_SILVER)
    print("MutualFund with swapped open/close saved (silver):",
          f"s3://{SILVER_BUCKET}/{MUTUAL_OUTPUT_KEY_SILVER}")
    print(df_mutual.head(10))

    del df_all, df_mutual, dfs

    # =====================================
    # 2) merged_etfs: unpivot + features + top10 + clean, all to silver
    # =====================================
    df_raw = read_csv_from_s3(BRONZE_BUCKET, MERGED_ETF_KEY_BRONZE)

    fund_return_cols = [col for col in df_raw.columns if col.startswith("fund_return_")]
    category_return_cols = [col for col in df_raw.columns if col.startswith("category_return_")]
    id_cols = [col for col in df_raw.columns if col not in fund_return_cols + category_return_cols]

    fund_unpivot = df_raw.melt(
        id_vars=id_cols,
        value_vars=fund_return_cols,
        var_name="period",
        value_name="fund_return"
    )
    fund_unpivot["period"] = fund_unpivot["period"].str.replace("fund_return_", "")

    category_unpivot = df_raw.melt(
        id_vars=id_cols,
        value_vars=category_return_cols,
        var_name="period_col",
        value_name="category_return"
    )
    category_unpivot["period"] = category_unpivot["period_col"].str.replace("category_return_", "")
    category_unpivot = category_unpivot.drop("period_col", axis=1)

    final_df = pd.merge(
        fund_unpivot,
        category_unpivot,
        on=id_cols + ["period"],
        how="outer"
    )

    print("Unpivot completed")
    print(f"Original shape: {df_raw.shape}")
    print(f"Final shape: {final_df.shape}")
    print(f"\nSample periods: {final_df['period'].unique()[:10]}")

    # 2.a) investment_strategy features (from raw df), save to silver
    if "investment_strategy" in df_raw.columns:
        df_raw["objective_type"] = df_raw["investment_strategy"].apply(extract_objective_type)
        df_raw["primary_asset_theme"] = df_raw["investment_strategy"].apply(extract_primary_asset_theme)
        df_raw["geo_focus"] = df_raw["investment_strategy"].apply(extract_geo_focus)

        feature_cols = ["objective_type", "primary_asset_theme", "geo_focus"]
        for cand in ["fund_symbol", "fund_id", "id"]:
            if cand in df_raw.columns:
                feature_cols = [cand] + feature_cols
                break

        df_features = df_raw[feature_cols].copy()
        write_csv_to_s3(df_features, SILVER_BUCKET, INVESTMENT_STRATEGY_KEY_SILVER)
        print("Saved investment_strategy ->",
              f"s3://{SILVER_BUCKET}/{INVESTMENT_STRATEGY_KEY_SILVER}")
        del df_features

    # 2.b) top10_holdings parsing from final_df, save to silver
    df_top10_holdings = pd.DataFrame()
    if "top10_holdings" in final_df.columns:
        all_rows = []
        FUND_ID_COL = "fund_symbol"

        for idx, row in final_df.iterrows():
            top10_str = row["top10_holdings"]
            parsed = parse_top10_string(top10_str)
            fund_id = row.get(FUND_ID_COL, None)

            for h in parsed:
                record = {
                    "original_index": idx,
                    "fund_id": fund_id,
                }
                record.update(h)
                all_rows.append(record)

        df_top10_holdings = pd.DataFrame(all_rows)

        if not df_top10_holdings.empty:
            # Drop duplicates
            df_top10_holdings = df_top10_holdings.drop_duplicates(
                subset=["fund_id", "holding_ticker", "holding_name", "holding_rank", "holding_weight"],
                keep="first"
            )
            # Keep ranks 1 to 10 only
            df_top10_holdings = df_top10_holdings[
                df_top10_holdings["holding_rank"].between(1, 10)
            ]

        write_csv_to_s3(df_top10_holdings, SILVER_BUCKET, TOP10_HOLDINGS_KEY_SILVER)
        print("Saved top10_holdings ->",
              f"s3://{SILVER_BUCKET}/{TOP10_HOLDINGS_KEY_SILVER}")
        del df_top10_holdings

    # 2.c) clean final_df and save merged_etfs to silver
    final_df.drop(columns=["investment_strategy"], inplace=True, errors="ignore")
    final_df.drop(columns=["top10_holdings"], inplace=True, errors="ignore")

    if {"fund_return", "category_return"}.issubset(final_df.columns):
        final_df = final_df.dropna(subset=["fund_return", "category_return"])
        final_df = final_df.drop_duplicates(subset=["fund_return", "category_return"], keep="first")

    write_csv_to_s3(final_df, SILVER_BUCKET, MERGED_ETF_KEY_SILVER)
    print("Cleaned merged_etfs saved (silver):",
          f"s3://{SILVER_BUCKET}/{MERGED_ETF_KEY_SILVER}")

    del final_df, df_raw, fund_unpivot, category_unpivot

    # =====================================
    # 3) etf from 2000: date features, save to silver
    # =====================================
    df = read_csv_from_s3(BRONZE_BUCKET, ETF2000_KEY_BRONZE)

    df["price_date"] = pd.to_datetime(df["price_date"], errors="coerce")
    df["day"] = df["price_date"].dt.day
    df["month"] = df["price_date"].dt.month
    df["quarter"] = df["price_date"].dt.quarter
    df["year"] = df["price_date"].dt.year

    write_csv_to_s3(df, SILVER_BUCKET, ETF2000_KEY_SILVER)
    print("Done! New ETF file saved as:",
          f"s3://{SILVER_BUCKET}/{ETF2000_KEY_SILVER}")
    print(df.head(10))


if __name__ == "__main__":
    main()
