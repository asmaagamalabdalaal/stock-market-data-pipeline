import sys, io
import boto3
import pandas as pd
import numpy as np

def get_arg(name, default=None):
    k = f"--{name}"
    return sys.argv[sys.argv.index(k)+1] if k in sys.argv else default

def parse_s3(s3_path):
    s3_path = s3_path.replace("s3://","",1)
    b, k = s3_path.split("/",1)
    return b, k

def s3_read_csv(path):
    b,k = parse_s3(path)
    obj = s3.get_object(Bucket=b, Key=k)
    return pd.read_csv(io.BytesIO(obj["Body"].read()))

def s3_write_csv(df, path):
    b,k = parse_s3(path)
    buf = io.StringIO()
    df.to_csv(buf, index=False)
    s3.put_object(Bucket=b, Key=k, Body=buf.getvalue().encode("utf-8"), ContentType="text/csv")

def col(df, name):
    return df[name] if name in df.columns else np.nan

s3 = boto3.client("s3")
SILVER = get_arg("SILVER_BASE", "s3://yahoo-finance-silver/silver/").rstrip("/") + "/"
GOLD   = get_arg("GOLD_BASE",   "s3://yahoo-finance-gold/tables/").rstrip("/") + "/"

m = s3_read_csv(SILVER + "merged_etfs.csv")

funds = pd.DataFrame({
    "fund_symbol": col(m, "fund_symbol").astype("string"),
    "fund_short_name": col(m, "fund_short_name"),
    "fund_long_name": col(m, "fund_long_name"),
    "investment_type": col(m, "investment_type"),
    "fund_family": col(m, "fund_family"),
    "fund_category": col(m, "fund_category"),
    "inception_date": pd.to_datetime(col(m,"inception_date"), errors="coerce").dt.date,
    "quote_type": col(m, "quote_type"),
    "exchange_code": col(m, "exchange_code"),
    "exchange_name": col(m, "exchange_name"),
    "exchange_timezone": col(m, "exchange_timezone"),
    "currency": col(m, "currency"),
    "region": col(m, "region"),
    "size_type": col(m, "size_type"),
})

funds = funds.dropna(subset=["fund_symbol"]).drop_duplicates(subset=["fund_symbol"])
funds = funds.sort_values("fund_symbol").reset_index(drop=True)
funds.insert(0, "fund_id", range(1, len(funds)+1))

out = GOLD + "dim_fund/dim_fund.csv"
s3_write_csv(funds, out)
print("Saved:", out)
