import sys, io
import boto3
import pandas as pd
import numpy as np

s3 = boto3.client("s3")


def get_arg(name, default=None):
    k = f"--{name}"
    return sys.argv[sys.argv.index(k)+1] if k in sys.argv else default

def parse_s3(path):
    path = path.replace("s3://", "", 1)
    bucket, key = path.split("/", 1)
    return bucket, key

def s3_read_csv(path):
    b, k = parse_s3(path)
    obj = s3.get_object(Bucket=b, Key=k)
    return pd.read_csv(io.BytesIO(obj["Body"].read()), encoding="utf-8-sig")

def s3_write_csv(df, path):
    b, k = parse_s3(path)
    buf = io.StringIO()
    df.to_csv(buf, index=False)
    s3.put_object(
        Bucket=b,
        Key=k,
        Body=buf.getvalue().encode("utf-8"),
        ContentType="text/csv"
    )

def col(df, name):
    # return same-length Series even if missing
    return df[name] if name in df.columns else pd.Series([pd.NA] * len(df))

def smart_parse_date(s):

    s = s.astype(str).str.strip()

    out = pd.Series(pd.NaT, index=s.index)

    mask_ymd = s.str.match(r"^\d{8}$")
    out.loc[mask_ymd] = pd.to_datetime(s.loc[mask_ymd], format="%Y%m%d", errors="coerce")

    mask_ts = s.str.match(r"^\d{10}$")
    out.loc[mask_ts] = pd.to_datetime(s.loc[mask_ts].astype(float), unit="s", errors="coerce")

    rest = ~(mask_ymd | mask_ts)
    out.loc[rest] = pd.to_datetime(s.loc[rest], errors="coerce")

    return out

def pick_best_date_column(df):
    candidates = ["price_date", "as_of_date", "date", "timestamp"] + \
                 [c for c in df.columns if ("date" in c.lower() or "time" in c.lower())]
    seen = []
    best_col, best_series, best_cnt = None, None, -1
    for c in candidates:
        if c in df.columns and c not in seen:
            seen.append(c)
            s = smart_parse_date(df[c])
            cnt = int(s.notna().sum())
            if cnt > best_cnt:
                best_cnt = cnt
                best_col, best_series = c, s
    return best_col, best_series, best_cnt

def pick_col(df, candidates):
    for c in candidates:
        if c in df.columns:
            return c
    return None


SILVER = get_arg("SILVER_BASE", "s3://yahoo-finance-silver/silver/").rstrip("/") + "/"
GOLD   = get_arg("GOLD_BASE",   "s3://yahoo-finance-gold/tables/").rstrip("/") + "/"

IN_PATH  = SILVER + "merged_etfs.csv"
OUT_PATH = GOLD + "dim_fund_evaluation/dim_fund_evaluation.csv"


m = s3_read_csv(IN_PATH)
print("Loaded rows:", len(m))
print("Columns sample:", list(m.columns)[:80])

date_col, date_series, good = pick_best_date_column(m)
if date_col is None or good <= 0:
    dbg = GOLD + "dim_fund_evaluation/_debug_no_dates.csv"
    s3_write_csv(m.head(200), dbg)
    raise ValueError(f"No usable date column found. Saved sample: {dbg}")

print("Using date column:", date_col, "| parsable dates:", good)
date_id = date_series.dt.strftime("%Y%m%d")

pe_col = pick_col(m, ["price_earning_ratio", "fund_price_earning_ratio", "fund_pe_ratio", "pe_ratio"])
pb_col = pick_col(m, ["price_book_ratio", "fund_price_book_ratio", "fund_pb_ratio", "pb_ratio"])
ps_col = pick_col(m, ["price_sales_ratio", "fund_price_sales_ratio", "fund_ps_ratio", "ps_ratio"])
pcf_col = pick_col(m, ["price_cashflow_ratio", "fund_price_cashflow_ratio", "fund_pcf_ratio", "pcf_ratio"])
yld_col = pick_col(m, ["fund_yield", "yield", "fund_distribution_yield", "distribution_yield"])

print("Mapped columns:")
print("  PE :", pe_col)
print("  PB :", pb_col)
print("  PS :", ps_col)
print("  PCF:", pcf_col)
print("  YLD:", yld_col)


df = pd.DataFrame({
    "date_id": pd.to_numeric(date_id, errors="coerce"),
    "price_earning_ratio": pd.to_numeric(col(m, pe_col) if pe_col else pd.Series([pd.NA]*len(m)), errors="coerce"),
    "price_book_ratio": pd.to_numeric(col(m, pb_col) if pb_col else pd.Series([pd.NA]*len(m)), errors="coerce"),
    "price_sales_ratio": pd.to_numeric(col(m, ps_col) if ps_col else pd.Series([pd.NA]*len(m)), errors="coerce"),
    "price_cashflow_ratio": pd.to_numeric(col(m, pcf_col) if pcf_col else pd.Series([pd.NA]*len(m)), errors="coerce"),
    "fund_yield": pd.to_numeric(col(m, yld_col) if yld_col else pd.Series([pd.NA]*len(m)), errors="coerce"),
})

print("Valid date_id:", int(df["date_id"].notna().sum()))

df = df.dropna(subset=["date_id"])

df = df.drop_duplicates(subset=["date_id"]).sort_values("date_id").reset_index(drop=True)

df.insert(0, "evaluation_id", range(1, len(df) + 1))


s3_write_csv(df, OUT_PATH)
print("Saved:", OUT_PATH)
print("Rows:", len(df))
print(df.head(10))
